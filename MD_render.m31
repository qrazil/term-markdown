// The renderer: a `doc.Block` tree to HTML.
//
// The line breaks follow cmark's, and they are produced the way cmark
// produces them: every block asks for a newline with `ensure_newline()`, which writes one
// only if the output does not already end in one. Getting that rule right is
// most of what makes the output comparable with a reference implementation --
// the tags are easy and the whitespace is not.
import MD_doc;
import encoding.html;
import MD_inlines;
import text;

// An output buffer that knows whether it is at the start of a line. Text is
// pushed onto a list and joined once, because building a megabyte of HTML
// with `+` is quadratic.
type Out {
    List<str> parts;
    bool is_at_line_start;
    // The document's link reference definitions, for the inline parser.
    Map<str, MD_doc.Reference> references;
}

void Out.put(str chunk) {
    if (chunk.size() == 0) {
        return;
    }
    parts.push(chunk);
    is_at_line_start = chunk.ends_with("\n");
}

void Out.ensure_newline() {
    if (!is_at_line_start) {
        parts.push("\n");
        is_at_line_start = true;
    }
}

str Out.text() {
    return parts.join("");
}

Out new_out(Map<str, MD_doc.Reference> references) {
    return Out([], true, references);
}

/// `parsed` as HTML: one line per block, cmark's layout.
pub str document(MD_doc.Document parsed) {
    Out out = new_out(parsed.references);
    blocks(out, parsed.blocks, false);
    return out.text();
}

void blocks(Out out, List<MD_doc.Block> block_list, bool is_tight) {
    for (MD_doc.Block current_block in block_list) {
        block(out, current_block, is_tight);
    }
}

void block(Out out, MD_doc.Block current_block, bool is_tight) {
    match (current_block) {
        case Rule: {
            out.ensure_newline();
            out.put("<hr />");
            out.ensure_newline();
        }
        case Paragraph(str raw): {
            // Inside a tight list a paragraph has no tags at all. That is
            // what "tight" means, and it is why the flag has to reach this
            // far down.
            if (is_tight) {
                out.put(MD_inlines.render(raw, out.references));
            } else {
                out.ensure_newline();
                out.put("<p>");
                out.put(MD_inlines.render(raw, out.references));
                out.put("</p>");
                out.ensure_newline();
            }
        }
        case Heading(MD_doc.Heading heading): {
            str tag = str(heading.level);
            out.ensure_newline();
            out.put("<h" + tag + ">");
            out.put(MD_inlines.render(heading.text, out.references));
            out.put("</h" + tag + ">");
            out.ensure_newline();
        }
        case Fence(MD_doc.Code code): {
            out.ensure_newline();
            out.put("<pre><code");
            str language = first_word(code.info);
            if (language.size() > 0) {
                out.put(" class=\"language-" + html.escape(language) + "\"");
            }
            out.put(">");
            out.put(html.escape(code.body));
            out.put("</code></pre>");
            out.ensure_newline();
        }
        case Quoted(MD_doc.Quote quote): {
            out.ensure_newline();
            out.put("<blockquote>");
            out.ensure_newline();
            blocks(out, quote.kids, false);
            out.ensure_newline();
            out.put("</blockquote>");
            out.ensure_newline();
        }
        case Bullets(MD_doc.Listing listing): {
            out.ensure_newline();
            if (listing.is_ordered) {
                if (listing.start == 1) {
                    out.put("<ol>");
                } else {
                    out.put("<ol start=\"" + str(listing.start) + "\">");
                }
            } else {
                out.put("<ul>");
            }
            out.ensure_newline();
            for (MD_doc.Item item in listing.items) {
                out.ensure_newline();
                out.put("<li>");
                blocks(out, item.kids, listing.is_tight);
                out.put("</li>");
                out.ensure_newline();
            }
            out.ensure_newline();
            if (listing.is_ordered) {
                out.put("</ol>");
            } else {
                out.put("</ul>");
            }
            out.ensure_newline();
        }
        case Grid(MD_doc.Table grid): {
            table(out, grid);
        }
    }
}

void table(Out out, MD_doc.Table grid) {
    out.ensure_newline();
    out.put("<table>");
    out.ensure_newline();
    out.put("<thead>");
    out.ensure_newline();
    out.put("<tr>");
    out.ensure_newline();
    for (int i in 0 .. grid.heads.size()) {
        out.put("<th" + align_attribute(grid.align, i) + ">");
        out.put(MD_inlines.render(grid.heads[i], out.references));
        out.put("</th>");
        out.ensure_newline();
    }
    out.put("</tr>");
    out.ensure_newline();
    out.put("</thead>");
    out.ensure_newline();
    if (grid.rows.size() > 0) {
        out.put("<tbody>");
        out.ensure_newline();
        for (List<str> row in grid.rows) {
            out.put("<tr>");
            out.ensure_newline();
            for (int column in 0 .. row.size()) {
                out.put("<td" + align_attribute(grid.align, column) + ">");
                out.put(MD_inlines.render(row[column], out.references));
                out.put("</td>");
                out.ensure_newline();
            }
            out.put("</tr>");
            out.ensure_newline();
        }
        out.put("</tbody>");
        out.ensure_newline();
    }
    out.put("</table>");
    out.ensure_newline();
}

str align_attribute(List<int> align, int column) {
    if (column >= align.size()) {
        return "";
    }
    if (align[column] == MD_doc.ALIGN_LEFT) {
        return " align=\"left\"";
    }
    if (align[column] == MD_doc.ALIGN_CENTER) {
        return " align=\"center\"";
    }
    if (align[column] == MD_doc.ALIGN_RIGHT) {
        return " align=\"right\"";
    }
    return "";
}

// The language of a fence: the first word of its info string. The rest of it
// is dropped, which is what cmark does with "``` ruby extra words".
str first_word(str info) {
    List<str> words = text.split_whitespace(info);
    if (words.size() == 0) {
        return "";
    }
    return words[0];
}
