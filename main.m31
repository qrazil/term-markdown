// markdown -- a CommonMark subset to HTML.
//
//   markdown README.md               the HTML fragment, on standard output
//   markdown --full --title T f.md   a whole document around it
//   markdown --full --theme bulma f.md   ... styled by Bulma (a CDN link)
//   markdown --full --css site.css f.md  ... plus a stylesheet of your own
//   markdown --out page.html f.md    write there instead of standard output
//   markdown --watch f.md --out page.html   rebuild whenever f.md changes
//   markdown                         reads standard input
//
// The grammar is Oro's (`lib/args`): `-word` is a command, so the short form of
// `--out` is `--o` and `-o` is refused; also `--version`, `--completions SHELL`.
//
// See README.md for what of CommonMark is in, what is out, and why.
import args;
import io;
import os;
import MD_build;
import MD_theme;
import MD_watch;

// Standard input, whole. `io.read_line_of` would do it a line at a time and
// this program needs all of it anyway.
Result<str, io.Error> read_stdin() {
    io.File input = io.stdin();
    bytes raw = input.read_all()?;
    match (raw.utf8()) {
        case Some(str content): {
            return Result<str, io.Error>.Ok(content);
        }
        case None: {
            return Result<str, io.Error>.Err(io.Error.InvalidUtf8);
        }
    }
}

Result<int, io.Error> emit(str out, str path) {
    if (path.size() == 0) {
        io.File output = io.stdout();
        return output.write(out.to_bytes());
    }
    return io.write(path, out);
}

int fail(str why) {
    io.eprint("markdown: " + why);
    return 1;
}

int run(args.Parsed options, int watch_limit) {
    str theme = options.value("theme").or("default");
    if (!MD_theme.is_theme(theme)) {
        io.eprint("markdown: --theme " + theme + ": expected " + MD_theme.THEME_NAMES);
        return 2;
    }
    str input = options.optional("file");
    str out_path = options.value("out").or("");
    MD_build.Job job = MD_build.Job(input, options.is_flag_set("full"), options.value("title").or(""), theme, options.value("css").or(""));
    if (options.is_flag_set("watch")) {
        if (out_path.size() == 0) {
            io.eprint("markdown: --watch needs --out PATH: the page is rewritten there on every change");
            return 2;
        }
        if (input.size() == 0 || input == "-") {
            io.eprint("markdown: --watch needs a file to watch, not standard input");
            return 2;
        }
        if (out_path == input) {
            io.eprint("markdown: --watch: --out is the file being watched; it would overwrite its own source");
            return 2;
        }
        return MD_watch.run(job, out_path, watch_limit);
    }
    str source = "";
    if (input.size() == 0 || input == "-") {
        match (read_stdin()) {
            case Ok(str content): {
                source = content;
            }
            case Err(io.Error error): {
                return fail("standard input: " + error.to_str());
            }
        }
    } else {
        match (io.read(input)) {
            case Ok(str content): {
                source = content;
            }
            case Err(io.Error error): {
                return fail(input + ": " + error.to_str());
            }
        }
    }
    str body = "";
    match (MD_build.convert(job, source)) {
        case Ok(str output): {
            body = output;
        }
        case Err(str why): {
            return fail(why);
        }
    }
    match (emit(body, out_path)) {
        case Ok(int written): {
            if (written != body.size()) {
                return fail("short write: " + str(written) + " of " + str(body.size()) + " bytes");
            }
            return 0;
        }
        case Err(io.Error error): {
            return fail("writing: " + error.to_str());
        }
    }
}

// Keep in step with `version` in the `deps` file.
const str VERSION = "0.4.0";

args.Parser parser = args.Parser("markdown", summary: "CommonMark (a subset) to HTML");
parser.version = VERSION;
parser.epilog = "exit status: 0 ok, 1 could not read or write, 2 usage error";
parser.flag("full", short: "f", help: "wrap the output in a whole HTML document");
parser.value("title", short: "t", placeholder: "TEXT", help: "the <title> of a --full document; default: the first # heading, else the file name");
parser.value("theme", placeholder: "NAME", default: "default", help: "--full styling: default (built in, works offline), bulma (Bulma 1.x from a CDN) or none");
parser.value("css", placeholder: "URL|PATH", help: "--full extra stylesheet: an http(s) URL is linked, a file is inlined; comes after the theme");
parser.value("out", short: "o", placeholder: "PATH", help: "write here instead of standard output");
parser.flag("watch", short: "w", help: "render, then render again whenever the file (or a --css file) changes; needs --out and a file; refresh the browser yourself");
parser.optional("file", "-", help: "the markdown to read; - or nothing is standard input");
parser.integer("watch-limit", min: "0", placeholder: "N", help: "with --watch: stop after N successful builds, the first included (0: never; the tests use it)");
parser.completions();
List<str> arguments = os.arguments();
arguments.remove_at(0);
match (parser.parse(arguments)) {
    case Err(args.UsageError error): {
        io.eprint("markdown: " + error.to_str());
        io.eprint(parser.usage());
        os.exit(2);
    }
    case Ok(args.Parsed parsed): {
        match (parsed.version()) {
            case Some(str version_line): {
                print(version_line);
                os.exit(0);
            }
            case None: {
            }
        }
        match (parsed.completions()) {
            case Some(str script): {
                print(script);
                os.exit(0);
            }
            case None: {
            }
        }
        match (parsed.help()) {
            case Some(str help_text): {
                print(help_text);
            }
            case None: {
                int code = run(parsed, parsed.integer("watch-limit").or(0));
                if (code != 0) {
                    os.exit(code);
                }
            }
        }
    }
}
