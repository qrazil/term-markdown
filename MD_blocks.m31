// The block parser: markdown source to a list of `doc.Block`.
//
// Line based and recursive. The document is split into lines once; every
// container -- a block quote, a list item -- strips its own marker off the
// lines it owns and hands the remainder back to `parse_lines`, so nesting
// costs a recursive call and nothing else.
//
// Inline content is NOT parsed here. A block keeps the raw source of its own
// text and `render` parses it later (see `doc`).
import MD_doc;
import math;
import text;

/// `source` as blocks. Line endings are normalised and leading tabs expanded
/// before anything else looks at the text.
pub List<MD_doc.Block> parse(str source) {
    return parse_lines(split_lines(source));
}

// --- lines -------------------------------------------------------------------

List<str> split_lines(str source) {
    List<str> out = [];
    for (str line in text.lines(source)) {
        out.push(expand_tabs(line));
    }
    return out;
}

// Tabs in the LEADING whitespace become spaces to the next four-column stop,
// which is the rule CommonMark indentation follows. A tab further along is
// left exactly as written: it is content, and a code block that held one
// should still hold one.
str expand_tabs(str line) {
    int length = line.size();
    int index = 0;
    int column = 0;
    bool has_tab = false;
    while (index < length) {
        int character = line.byte_at(index);
        if (character == '\t') {
            has_tab = true;
        } else if (character != ' ') {
            index = length;
            continue;
        }
        index = index + 1;
    }
    if (!has_tab) {
        return line;
    }
    List<str> out = [];
    index = 0;
    while (index < length) {
        int character = line.byte_at(index);
        if (character == ' ') {
            out.push(" ");
            column = column + 1;
        } else if (character == '\t') {
            int pad = 4 - column % 4;
            out.push(" ".repeat(pad));
            column = column + pad;
        } else {
            out.push(line.substr(index, length));
            index = length;
            continue;
        }
        index = index + 1;
    }
    return out.join("");
}

int indent_of(str line) {
    int length = line.size();
    int index = 0;
    while (index < length && line.byte_at(index) == ' ') {
        index = index + 1;
    }
    return index;
}

// `line` without its first `skip` characters, or "" if it is shorter.
str chop(str line, int skip) {
    int length = line.size();
    if (skip >= length) {
        return "";
    }
    return line.substr(skip, length);
}

bool is_blank(str line) {
    return line.trim().size() == 0;
}

// --- line shapes -------------------------------------------------------------

// `***`, `---`, `___`: three or more of one character, spaces allowed
// between them, nothing else on the line. `stripped` has had its indent removed.
bool is_thematic_break(str stripped) {
    int length = stripped.size();
    if (length < 3) {
        return false;
    }
    int character = stripped.byte_at(0);
    if (character != '*' && character != '-' && character != '_') {
        return false;
    }
    int count = 0;
    for (int i in 0 .. length) {
        int current = stripped.byte_at(i);
        if (current == character) {
            count = count + 1;
        } else if (current != ' ' && current != '\t') {
            return false;
        }
    }
    return count >= 3;
}

// The `#` count of an ATX heading, or 0.
int atx_level(str stripped) {
    int length = stripped.size();
    int index = 0;
    while (index < length && index < 7 && stripped.byte_at(index) == '#') {
        index = index + 1;
    }
    if (index == 0 || index > 6) {
        return 0;
    }
    if (index < length && stripped.byte_at(index) != ' ' && stripped.byte_at(index) != '\t') {
        return 0;
    }
    return index;
}

// The text of an ATX heading whose marker is `level` characters long: the
// rest of the line, with a closing run of `#` taken off.
str atx_text(str stripped, int level) {
    str body = chop(stripped, level).trim();
    int length = body.size();
    int index = length;
    while (index > 0 && body.byte_at(index - 1) == '#') {
        index = index - 1;
    }
    if (index == 0) {
        return "";
    }
    if (index < length && (body.byte_at(index - 1) == ' ' || body.byte_at(index - 1) == '\t')) {
        return body.substr(0, index).trim();
    }
    return body;
}

// The fence character of an opening code fence, or 0.
int fence_character(str stripped) {
    int length = stripped.size();
    if (length < 3) {
        return 0;
    }
    int character = stripped.byte_at(0);
    if (character != '`' && character != '~') {
        return 0;
    }
    int index = 0;
    while (index < length && stripped.byte_at(index) == character) {
        index = index + 1;
    }
    if (index < 3) {
        return 0;
    }
    // A backtick fence's info string may not hold a backtick, or ``a`` at the
    // start of a line would open a block instead of a code span.
    if (character == '`' && chop(stripped, index).contains("`")) {
        return 0;
    }
    return character;
}

int run_length(str stripped, int character) {
    int length = stripped.size();
    int index = 0;
    while (index < length && stripped.byte_at(index) == character) {
        index = index + 1;
    }
    return index;
}

// The level of a setext underline, or 0.
int setext_level(str stripped) {
    int length = stripped.size();
    if (length == 0) {
        return 0;
    }
    int character = stripped.byte_at(0);
    if (character != '=' && character != '-') {
        return 0;
    }
    int index = 0;
    while (index < length && stripped.byte_at(index) == character) {
        index = index + 1;
    }
    while (index < length && (stripped.byte_at(index) == ' ' || stripped.byte_at(index) == '\t')) {
        index = index + 1;
    }
    if (index < length) {
        return 0;
    }
    if (character == '=') {
        return 1;
    }
    return 2;
}

// A list marker at the start of `stripped`. `length` counts the marker's own
// characters -- 1 for `-`, 3 for `10.` -- and `character` is `-`, `+`, `*`, `.` or
// `)`, which is what decides whether two items belong to one list.
type Marker {
    bool is_found;
    bool is_ordered;
    int number;
    int character;
    int length;
}

Marker marker_of(str stripped) {
    int length = stripped.size();
    if (length == 0) {
        return Marker(false, false, 0, 0, 0);
    }
    int character = stripped.byte_at(0);
    if (character == '-' || character == '+' || character == '*') {
        if (length > 1 && stripped.byte_at(1) != ' ' && stripped.byte_at(1) != '\t') {
            return Marker(false, false, 0, 0, 0);
        }
        return Marker(true, false, 0, character, 1);
    }
    int index = 0;
    while (index < length && index < 9 && stripped.byte_at(index) >= '0' && stripped.byte_at(index) <= '9') {
        index = index + 1;
    }
    if (index == 0 || index >= length) {
        return Marker(false, false, 0, 0, 0);
    }
    int delimiter = stripped.byte_at(index);
    if (delimiter != '.' && delimiter != ')') {
        return Marker(false, false, 0, 0, 0);
    }
    if (index + 1 < length && stripped.byte_at(index + 1) != ' ' && stripped.byte_at(index + 1) != '\t') {
        return Marker(false, false, 0, 0, 0);
    }
    return Marker(true, true, stripped.substr(0, index).parse_int().or(0), delimiter, index + 1);
}

// Does `stripped` begin a block that a paragraph cannot swallow?
bool is_block_start(str stripped) {
    return is_thematic_break(stripped) || atx_level(stripped) > 0 || fence_character(stripped) != 0 || stripped.starts_with(">");
}

// A list item may interrupt a paragraph only when it is not empty, and an
// ordered one only when it is numbered 1 -- otherwise every line beginning
// "2024. " would start a list.
bool can_interrupt_paragraph(str stripped) {
    Marker marker = marker_of(stripped);
    if (!marker.is_found) {
        return false;
    }
    if (chop(stripped, marker.length).trim().size() == 0) {
        return false;
    }
    return !marker.is_ordered || marker.number == 1;
}

// Add `line` to `held` as a LAZY continuation of the paragraph already
// there, by gluing it onto the previous line rather than pushing it.
//
// It has to be glued. A container strips its markers and hands the remaining
// lines back to `parse_lines`, which is what makes nesting one recursive
// call -- but that loses the fact that a line arrived lazily, and a lazy
// line is paragraph text and nothing else. Handed over on its own, `===`
// under `> quote` would become a setext underline and `- x` would become a
// list. Inside the previous line it cannot be either, and the paragraph
// joins its lines with a newline anyway, so the text comes out the same.
void lazily(List<str> held, str line) {
    int last = held.size() - 1;
    held[last] = held[last] + "\n" + text.trim_start(line);
}

// --- the parser --------------------------------------------------------------

List<MD_doc.Block> parse_lines(List<str> lines) {
    List<MD_doc.Block> out = [];
    int line_count = lines.size();
    int line_index = 0;
    while (line_index < line_count) {
        str line = lines[line_index];
        if (is_blank(line)) {
            line_index = line_index + 1;
            continue;
        }
        int indent = indent_of(line);
        str stripped = chop(line, indent);
        if (indent >= 4) {
            line_index = indented_code(out, lines, line_index);
            continue;
        }
        if (is_thematic_break(stripped)) {
            out.push(MD_doc.Block.Rule);
            line_index = line_index + 1;
            continue;
        }
        int level = atx_level(stripped);
        if (level > 0) {
            out.push(MD_doc.Block.Heading(MD_doc.Heading(level, atx_text(stripped, level))));
            line_index = line_index + 1;
            continue;
        }
        if (fence_character(stripped) != 0) {
            line_index = fenced_code(out, lines, line_index);
            continue;
        }
        if (stripped.starts_with(">")) {
            line_index = block_quote(out, lines, line_index);
            continue;
        }
        if (marker_of(stripped).is_found) {
            line_index = list_at(out, lines, line_index);
            continue;
        }
        if (is_table_head(lines, line_index)) {
            line_index = table_at(out, lines, line_index);
            continue;
        }
        line_index = paragraph(out, lines, line_index);
    }
    return out;
}

// --- leaf blocks -------------------------------------------------------------

int indented_code(List<MD_doc.Block> out, List<str> lines, int start_line) {
    int line_count = lines.size();
    List<str> body = [];
    int line_index = start_line;
    int last = start_line;
    while (line_index < line_count) {
        str line = lines[line_index];
        if (is_blank(line)) {
            body.push("");
            line_index = line_index + 1;
            continue;
        }
        if (indent_of(line) < 4) {
            line_index = line_count;
            continue;
        }
        body.push(chop(line, 4));
        last = line_index;
        line_index = line_index + 1;
    }
    while (body.size() > 0 && body[body.size() - 1].size() == 0) {
        body.pop();
    }
    out.push(MD_doc.Block.Fence(MD_doc.Code("", body.join("\n") + "\n")));
    return last + 1;
}

int fenced_code(List<MD_doc.Block> out, List<str> lines, int start_line) {
    int line_count = lines.size();
    str open = lines[start_line];
    int indent = indent_of(open);
    str stripped = chop(open, indent);
    int character = fence_character(stripped);
    int width = run_length(stripped, character);
    str info = chop(stripped, width).trim();
    List<str> body = [];
    int line_index = start_line + 1;
    bool is_closed = false;
    while (line_index < line_count && !is_closed) {
        str line = lines[line_index];
        int line_indent = indent_of(line);
        str line_stripped = chop(line, line_indent);
        if (line_indent < 4 && run_length(line_stripped, character) >= width && chop(line_stripped, run_length(line_stripped, character)).trim().size() == 0) {
            is_closed = true;
            line_index = line_index + 1;
            continue;
        }
        body.push(chop(line, math.min(indent, indent_of(line))));
        line_index = line_index + 1;
    }
    str text_of = "";
    if (body.size() > 0) {
        text_of = body.join("\n") + "\n";
    }
    out.push(MD_doc.Block.Fence(MD_doc.Code(info, text_of)));
    return line_index;
}

int block_quote(List<MD_doc.Block> out, List<str> lines, int start_line) {
    int line_count = lines.size();
    List<str> inner = [];
    int line_index = start_line;
    bool is_done = false;
    while (line_index < line_count && !is_done) {
        str line = lines[line_index];
        int line_indent = indent_of(line);
        str stripped = chop(line, line_indent);
        if (line_indent < 4 && stripped.starts_with(">")) {
            str body = chop(stripped, 1);
            if (body.starts_with(" ")) {
                body = chop(body, 1);
            }
            inner.push(body);
            line_index = line_index + 1;
            continue;
        }
        // Lazy continuation: a bare line carries on the quote's paragraph,
        // but only if a paragraph is what it would carry on.
        if (is_blank(line) || inner.size() == 0 || is_blank(inner[inner.size() - 1])) {
            is_done = true;
            continue;
        }
        // Any list marker ends the quote, not only one that could interrupt
        // a paragraph: a lazy line is matched against the DOCUMENT, where
        // there is no paragraph for the "must not be empty, must be
        // numbered 1" rule to protect.
        if (line_indent < 4 && (is_block_start(stripped) || marker_of(stripped).is_found)) {
            is_done = true;
            continue;
        }
        lazily(inner, line);
        line_index = line_index + 1;
    }
    out.push(MD_doc.Block.Quoted(MD_doc.Quote(parse_lines(inner))));
    return line_index;
}

int paragraph(List<MD_doc.Block> out, List<str> lines, int start_line) {
    int line_count = lines.size();
    List<str> paragraph_lines = [];
    int line_index = start_line;
    bool is_done = false;
    while (line_index < line_count && !is_done) {
        str line = lines[line_index];
        if (is_blank(line)) {
            is_done = true;
            continue;
        }
        int line_indent = indent_of(line);
        str stripped = chop(line, line_indent);
        if (line_indent < 4 && paragraph_lines.size() > 0 && setext_level(stripped) > 0) {
            out.push(MD_doc.Block.Heading(MD_doc.Heading(setext_level(stripped), paragraph_lines.join("\n").trim())));
            return line_index + 1;
        }
        if (line_indent < 4 && (is_block_start(stripped) || can_interrupt_paragraph(stripped))) {
            is_done = true;
            continue;
        }
        paragraph_lines.push(text.trim_start(line));
        line_index = line_index + 1;
    }
    if (paragraph_lines.size() > 0) {
        // The trailing spaces of the LAST line are not a hard break -- there
        // is no line after them -- so the paragraph loses them here, where
        // the inline parser would otherwise print them.
        out.push(MD_doc.Block.Paragraph(paragraph_lines.join("\n").trim()));
    }
    return line_index;
}

// --- lists -------------------------------------------------------------------

int list_at(List<MD_doc.Block> out, List<str> lines, int start_line) {
    int line_count = lines.size();
    Marker first = marker_of(chop(lines[start_line], indent_of(lines[start_line])));
    List<MD_doc.Item> items = [];
    bool is_loose = false;
    int line_index = start_line;
    bool is_done = false;
    while (line_index < line_count && !is_done) {
        str line = lines[line_index];
        int line_indent = indent_of(line);
        Marker marker = marker_of(chop(line, line_indent));
        // `- - -` is a thematic break and not three items: the break wins,
        // here as in `parse_lines`.
        if (line_indent >= 4 || is_thematic_break(chop(line, line_indent)) || !marker.is_found || marker.character != first.character) {
            is_done = true;
            continue;
        }
        // Where this item's content starts. One to four spaces after the
        // marker indent to that column; five or more mean the content is an
        // indented code block that begins one space in.
        int after = line_indent + marker.length;
        int spaces = 0;
        while (after + spaces < line.size() && line.byte_at(after + spaces) == ' ') {
            spaces = spaces + 1;
        }
        int content_indent = after + 1;
        if (after + spaces < line.size() && spaces >= 1 && spaces <= 4) {
            content_indent = after + spaces;
        }
        List<str> body = [];
        body.push(chop(line, content_indent));
        line_index = line_index + 1;
        bool has_pending_blank = false;
        bool is_ended = false;
        while (line_index < line_count && !is_ended) {
            str following = lines[line_index];
            if (is_blank(following)) {
                has_pending_blank = true;
                line_index = line_index + 1;
                continue;
            }
            int following_indent = indent_of(following);
            if (following_indent >= content_indent) {
                if (has_pending_blank) {
                    body.push("");
                    is_loose = true;
                    has_pending_blank = false;
                }
                body.push(chop(following, content_indent));
                line_index = line_index + 1;
                continue;
            }
            str following_stripped = chop(following, following_indent);
            // A line indented four or more cannot be indented code here,
            // because indented code may not interrupt a paragraph -- so it
            // is lazy text whatever it looks like.
            // Any marker ends the item -- `2.` after `1.` is the next item,
            // and `*` alone is an empty item of a new list. The "must not be
            // empty, must be numbered 1" rule is only for interrupting a
            // paragraph, and a lazy line is matched against the document.
            bool is_lazy = following_indent >= 4 || !is_block_start(following_stripped) && !marker_of(following_stripped).is_found;
            if (!has_pending_blank && !is_blank(body[body.size() - 1]) && is_lazy) {
                lazily(body, following);
                line_index = line_index + 1;
                continue;
            }
            is_ended = true;
        }
        items.push(MD_doc.Item(parse_lines(body)));
        // A blank line between two items makes the whole list loose -- but
        // only if another item really follows. `- - -` after a blank line
        // looks like a marker and is a thematic break, which ends the list
        // and leaves it tight.
        if (has_pending_blank && line_index < line_count) {
            str next = lines[line_index];
            int next_indent = indent_of(next);
            str next_stripped = chop(next, next_indent);
            Marker next_marker = marker_of(next_stripped);
            if (next_indent < 4 && !is_thematic_break(next_stripped) && next_marker.is_found && next_marker.character == first.character) {
                is_loose = true;
            }
        }
    }
    int start = 1;
    if (first.is_ordered) {
        start = first.number;
    }
    out.push(MD_doc.Block.Bullets(MD_doc.Listing(first.is_ordered, start, !is_loose, items)));
    return line_index;
}

// --- tables (a GFM extension, not CommonMark) --------------------------------

bool is_table_head(List<str> lines, int start_line) {
    if (start_line + 1 >= lines.size()) {
        return false;
    }
    if (!lines[start_line].contains("|")) {
        return false;
    }
    List<str> head = cells_of(lines[start_line]);
    List<str> rule = cells_of(lines[start_line + 1]);
    if (head.size() == 0 || head.size() != rule.size()) {
        return false;
    }
    for (str cell in rule) {
        if (align_of(cell) < 0) {
            return false;
        }
    }
    return true;
}

// `:-`, `-:`, `:-:` or `-`, with at least one dash. -1 means this is not a
// delimiter cell at all.
int align_of(str cell) {
    str trimmed = cell.trim();
    int length = trimmed.size();
    if (length == 0) {
        return -1;
    }
    bool has_leading_colon = trimmed.byte_at(0) == ':';
    bool has_trailing_colon = trimmed.byte_at(length - 1) == ':';
    int dash_start = 0;
    if (has_leading_colon) {
        dash_start = 1;
    }
    int dash_end = length;
    if (has_trailing_colon) {
        dash_end = length - 1;
    }
    if (dash_end <= dash_start) {
        return -1;
    }
    for (int offset in dash_start .. dash_end) {
        if (trimmed.byte_at(offset) != '-') {
            return -1;
        }
    }
    if (has_leading_colon && has_trailing_colon) {
        return MD_doc.ALIGN_CENTER;
    }
    if (has_leading_colon) {
        return MD_doc.ALIGN_LEFT;
    }
    if (has_trailing_colon) {
        return MD_doc.ALIGN_RIGHT;
    }
    return MD_doc.ALIGN_NONE;
}

// One row split on its unescaped pipes, with the optional leading and
// trailing pipe dropped.
List<str> cells_of(str line) {
    str row = line.trim();
    if (row.starts_with("|")) {
        row = chop(row, 1);
    }
    if (row.ends_with("|") && !row.ends_with("\\|")) {
        row = row.substr(0, row.size() - 1);
    }
    List<str> out = [];
    List<str> part = [];
    int length = row.size();
    int index = 0;
    int from = 0;
    while (index < length) {
        int character = row.byte_at(index);
        if (character == '\\' && index + 1 < length && row.byte_at(index + 1) == '|') {
            part.push(row.substr(from, index));
            part.push("|");
            index = index + 2;
            from = index;
            continue;
        }
        if (character == '|') {
            part.push(row.substr(from, index));
            out.push(part.join("").trim());
            part.clear();
            index = index + 1;
            from = index;
            continue;
        }
        index = index + 1;
    }
    part.push(row.substr(from, length));
    out.push(part.join("").trim());
    return out;
}

int table_at(List<MD_doc.Block> out, List<str> lines, int start_line) {
    List<str> heads = cells_of(lines[start_line]);
    List<int> align = [];
    for (str cell in cells_of(lines[start_line + 1])) {
        align.push(align_of(cell));
    }
    List<List<str>> rows = [];
    int line_count = lines.size();
    int line_index = start_line + 2;
    bool is_done = false;
    while (line_index < line_count && !is_done) {
        str line = lines[line_index];
        if (is_blank(line)) {
            is_done = true;
            continue;
        }
        int line_indent = indent_of(line);
        str stripped = chop(line, line_indent);
        if (line_indent < 4 && (is_block_start(stripped) || marker_of(stripped).is_found)) {
            is_done = true;
            continue;
        }
        List<str> cells = cells_of(line);
        while (cells.size() < heads.size()) {
            cells.push("");
        }
        while (cells.size() > heads.size()) {
            cells.pop();
        }
        rows.push(cells);
        line_index = line_index + 1;
    }
    out.push(MD_doc.Block.Grid(MD_doc.Table(heads, align, rows)));
    return line_index;
}
