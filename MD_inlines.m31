// The inline parser: one block's raw markdown source to the HTML that goes
// inside its element.
//
// Two passes, which is what CommonMark's emphasis rules need and what a
// single left-to-right scan cannot do. The first pass walks the bytes and
// produces a list of `Node`s: a node is either FINISHED HTML (a code span, a
// link, an escaped run of text) or an unresolved RUN of `*` or `_`. The
// second pass, `emphasis`, pairs the runs up and hangs `<em>`/`<strong>` tags
// on them. `emit` then concatenates.
//
// Text is escaped as it is pushed, not at the end, so a node is either final
// HTML or a delimiter run and there is no third state to keep straight.
//
// The module is named `inlines` and not `inline` because `inline` is a C
// keyword and this compiler emits C.
import MD_doc;
import encoding.html;
import text;
import text.unicode;

// --- character classes -------------------------------------------------------
//
// Everything here is ASCII, and looks at BYTES. That is exact for the classes
// it needs -- every byte of a non-ASCII character is >= 128, so a multi-byte
// character is uniformly "other", which is what a letter is -- and it is the
// one place this parser knowingly differs from CommonMark, which classifies
// by Unicode category. `é` and `字` are "other" here and there; U+00A0 and
// `»` are "other" here and whitespace/punctuation there. See README.

/// Is `character` one of the ASCII spaces: space, tab, line feed, carriage
/// return, vertical tab, form feed?
pub bool is_space_byte(int character) {
    return character == ' ' || character == '\t' || character == '\n' || character == '\r' || character == 11 || character == 12;
}

/// Is `character` ASCII punctuation, the characters a backslash may escape?
pub bool is_punctuation_byte(int character) {
    if (character >= '!' && character <= '/') {
        return true;
    }
    if (character >= ':' && character <= '@') {
        return true;
    }
    if (character >= '[' && character <= '`') {
        return true;
    }
    return character >= '{' && character <= '~';
}

bool is_alphabetic_byte(int character) {
    return (character >= 'A' && character <= 'Z') || (character >= 'a' && character <= 'z');
}

bool is_digit_byte(int character) {
    return character >= '0' && character <= '9';
}

bool is_alphanumeric_byte(int character) {
    return is_alphabetic_byte(character) || is_digit_byte(character);
}

// --- URL escaping ------------------------------------------------------------
//
// cmark's `houdini_escape_href`, reproduced: `&` becomes `&amp;`, `'` becomes
// `&#x27;`, and every byte outside the safe set becomes `%XX` with upper-case
// hex. The safe set is alphanumerics plus this punctuation, which is what
// cmark's HREF_SAFE table holds -- note that `<`, `>`, `"`, `[`, `\`, `]`,
// `^`, `{`, `|`, `}`, space and DEL are NOT in it.
const str HREF_SAFE = "!#$%&'()*+,-./:;=?@_~`";
const str HEX = "0123456789ABCDEF";

bool is_href_safe(int character) {
    if (is_alphanumeric_byte(character)) {
        return true;
    }
    return HREF_SAFE.index_of(str.from_chars([character])).is_some();
}

/// `destination` percent-encoded for an `href=".."` attribute.
pub str escape_href(str destination) {
    List<str> out = [];
    int length = destination.size();
    for (int i in 0 .. length) {
        int character = destination.byte_at(i);
        if (character == '&') {
            out.push("&amp;");
        } else if (character == '\'') {
            out.push("&#x27;");
        } else if (is_href_safe(character)) {
            out.push(destination.substr(i, i + 1));
        } else {
            out.push("%");
            out.push(HEX.substr(character / 16, character / 16 + 1));
            out.push(HEX.substr(character % 16, character % 16 + 1));
        }
    }
    return out.join("");
}

// --- nodes -------------------------------------------------------------------

// Either finished HTML (`is_delimiter` false, `out` is it) or an unresolved run of
// `*` or `_`. `original` is how many were written, `count` how many are still
// unpaired; `open_tags` grows leftwards and `close_tags` rightwards as the
// second pass hangs tags on the run, which is the order that makes
// `***x***` come out `<em><strong>x</strong></em>`.
type Node {
    bool is_delimiter;
    str out;
    int character;
    int original;
    int count;
    // What the flanking rules said when the run was scanned. These never
    // change: the rule of three asks what a run IS, not what is left of it.
    bool can_open;
    bool can_close;
    // Off the delimiter stack. A dead run is no longer a candidate for
    // pairing, but its unspent characters are still printed -- which is what
    // "unlinking the delimiter but not the text node" means in cmark.
    bool is_dead;
    str open_tags;
    str close_tags;
}

Node html_node(str markup) {
    return Node(false, markup, 0, 0, 0, false, false, false, "", "");
}

Node delimiter_node(int character, int length, bool can_open, bool can_close) {
    return Node(true, "", character, length, length, can_open, can_close, false, "", "");
}

str mark_of(int character) {
    if (character == '*') {
        return "*";
    }
    return "_";
}

// --- the scan ----------------------------------------------------------------

/// `source`, a block's raw inline source, as the HTML that goes inside its element.
/// `references` are the document's link reference definitions, which
/// `[text][label]`, `[text][]` and `[label]` look up; an empty map makes
/// every one of those literal text.
pub str render(str source, Map<str, MD_doc.Reference> references) {
    return render_at(source, references, 0);
}

// The same, with the plain text only: every tag removed. This is what an
// image's `alt` attribute holds, and rendering then stripping is how the
// literal-vs-emphasis question is answered without a second parser.
str plain(str source, Map<str, MD_doc.Reference> references) {
    return strip_tags(render_at(source, references, 0));
}

str render_at(str source, Map<str, MD_doc.Reference> references, int depth) {
    List<Node> nodes = scan(source, brackets(source), references, depth);
    emphasis(nodes);
    return emit(nodes);
}

// For every `[` in `source`, the offset of the `]` that closes it, or -1. An empty
// list means there is no `[` at all.
//
// One pass with a stack, which is the whole reason this exists: searching
// forward for the matching `]` at each `[` is quadratic, and 50 000
// unmatched `[` -- 50 KB, an entirely possible thing to be handed -- took
// four and a half seconds that way. It is the same answer, because a
// stack's match and a depth count's match are the same bracket.
//
// A backslash escapes a bracket and a code span hides one, so a `]` inside
// a code span does not close the link that contains it.
List<int> brackets(str source) {
    int length = source.size();
    if (source.index_of("[").is_none()) {
        return [];
    }
    List<int> shut = [-1; length];
    List<int> open = [];
    int index = 0;
    while (index < length) {
        int character = source.byte_at(index);
        if (character == '\\') {
            index = index + 2;
            continue;
        }
        if (character == '`') {
            index = skip_code(source, index);
            continue;
        }
        if (character == '[') {
            open.push(index);
        } else if (character == ']' && open.size() > 0) {
            shut[open.pop()] = index;
        }
        index = index + 1;
    }
    return shut;
}

List<Node> scan(str source, List<int> shut, Map<str, MD_doc.Reference> references, int depth) {
    List<Node> nodes = [];
    int length = source.size();
    int index = 0;
    int from = 0;
    while (index < length) {
        int character = source.byte_at(index);
        if (character == '\\') {
            // A backslash escapes ASCII punctuation, and ends a line hard.
            if (index + 1 < length && source.byte_at(index + 1) == '\n') {
                flush(nodes, source, from, index);
                nodes.push(html_node("<br />\n"));
                index = index + 2;
                index = skip_indent(source, index);
                from = index;
                continue;
            }
            if (index + 1 < length && is_punctuation_byte(source.byte_at(index + 1))) {
                flush(nodes, source, from, index);
                nodes.push(html_node(html.escape(source.substr(index + 1, index + 2))));
                index = index + 2;
                from = index;
                continue;
            }
            index = index + 1;
            continue;
        }
        if (character == '`') {
            int after = code_span(nodes, source, index, from);
            if (after > index) {
                index = after;
                from = index;
                continue;
            }
            // Not a span: the run is literal, and skipping it whole stops the
            // next backtick from opening one inside it.
            int run_end = index;
            while (run_end < length && source.byte_at(run_end) == '`') {
                run_end = run_end + 1;
            }
            index = run_end;
            continue;
        }
        if (character == '<') {
            int after = autolink(nodes, source, index, from);
            if (after > index) {
                index = after;
                from = index;
                continue;
            }
            index = index + 1;
            continue;
        }
        if (character == '[' || character == '!' && index + 1 < length && source.byte_at(index + 1) == '[') {
            int after = link(nodes, source, shut, references, index, from, depth);
            if (after > index) {
                index = after;
                from = index;
                continue;
            }
            index = index + 1;
            continue;
        }
        if (character == '\n') {
            // A line break. Two or more trailing spaces make it hard; the
            // trailing spaces go either way, and so does the next line's
            // indent.
            int back = index;
            while (back > from && source.byte_at(back - 1) == ' ') {
                back = back - 1;
            }
            flush(nodes, source, from, back);
            if (index - back >= 2) {
                nodes.push(html_node("<br />\n"));
            } else {
                nodes.push(html_node("\n"));
            }
            index = skip_indent(source, index + 1);
            from = index;
            continue;
        }
        if (character == '*' || character == '_') {
            int run_end = index;
            while (run_end < length && source.byte_at(run_end) == character) {
                run_end = run_end + 1;
            }
            flush(nodes, source, from, index);
            nodes.push(run_at(source, index, run_end, character));
            index = run_end;
            from = index;
            continue;
        }
        index = index + 1;
    }
    flush(nodes, source, from, length);
    return nodes;
}

void flush(List<Node> nodes, str source, int from, int stop) {
    if (stop > from) {
        nodes.push(html_node(html.escape(source.substr(from, stop))));
    }
}

int skip_indent(str source, int start) {
    int length = source.size();
    int index = start;
    while (index < length && (source.byte_at(index) == ' ' || source.byte_at(index) == '\t')) {
        index = index + 1;
    }
    return index;
}

// The delimiter run `source[start..stop)` of `character`, classified. The rules are CommonMark's
// left-flanking and right-flanking, over the byte before and the byte after.
Node run_at(str source, int start, int stop, int character) {
    int before = 32;
    if (start > 0) {
        before = source.byte_at(start - 1);
    }
    int after = 32;
    if (stop < source.size()) {
        after = source.byte_at(stop);
    }
    bool is_space_before = is_space_byte(before);
    bool is_punctuation_before = is_punctuation_byte(before);
    bool is_space_after = is_space_byte(after);
    bool is_punctuation_after = is_punctuation_byte(after);
    bool is_left_flanking = !is_space_after && (!is_punctuation_after || is_space_before || is_punctuation_before);
    bool is_right_flanking = !is_space_before && (!is_punctuation_before || is_space_after || is_punctuation_after);
    if (character == '_') {
        return delimiter_node(character, stop - start, is_left_flanking && (!is_right_flanking || is_punctuation_before), is_right_flanking && (!is_left_flanking || is_punctuation_after));
    }
    return delimiter_node(character, stop - start, is_left_flanking, is_right_flanking);
}

// --- code spans --------------------------------------------------------------

// Returns the offset just past the span, or `start` if the backtick run at `start`
// opens nothing.
int code_span(List<Node> nodes, str source, int start, int from) {
    int length = source.size();
    int run_end = start;
    while (run_end < length && source.byte_at(run_end) == '`') {
        run_end = run_end + 1;
    }
    int want = run_end - start;
    int cursor = run_end;
    int found = -1;
    while (cursor < length && found < 0) {
        if (source.byte_at(cursor) == '`') {
            int close_end = cursor;
            while (close_end < length && source.byte_at(close_end) == '`') {
                close_end = close_end + 1;
            }
            if (close_end - cursor == want) {
                found = cursor;
            } else {
                cursor = close_end;
            }
        } else {
            cursor = cursor + 1;
        }
    }
    if (found < 0) {
        return start;
    }
    str body = text.replace(source.substr(run_end, found), "\n", " ");
    if (body.size() >= 2 && body.starts_with(" ") && body.ends_with(" ") && body.trim().size() > 0) {
        body = body.substr(1, body.size() - 1);
    }
    flush(nodes, source, from, start);
    nodes.push(html_node("<code>" + html.escape(body) + "</code>"));
    return found + want;
}

// --- autolinks ---------------------------------------------------------------

int autolink(List<Node> nodes, str source, int start, int from) {
    int length = source.size();
    int stop = start + 1;
    while (stop < length) {
        int character = source.byte_at(stop);
        if (character == '>') {
            break;
        }
        if (character == '<' || is_space_byte(character)) {
            return start;
        }
        stop = stop + 1;
    }
    if (stop >= length) {
        return start;
    }
    str body = source.substr(start + 1, stop);
    if (is_uri(body)) {
        flush(nodes, source, from, start);
        nodes.push(html_node("<a href=\"" + escape_href(body) + "\">" + html.escape(body) + "</a>"));
        return stop + 1;
    }
    if (is_email(body)) {
        flush(nodes, source, from, start);
        nodes.push(html_node("<a href=\"mailto:" + escape_href(body) + "\">" + html.escape(body) + "</a>"));
        return stop + 1;
    }
    return start;
}

// `scheme:rest`, where the scheme is 2 to 32 characters starting with a
// letter. The characters that would have ended the scan -- space, `<`, `>` --
// are already gone.
bool is_uri(str body) {
    int length = body.size();
    if (length == 0 || !is_alphabetic_byte(body.byte_at(0))) {
        return false;
    }
    for (int i in 1 .. length) {
        int character = body.byte_at(i);
        if (character == ':') {
            return i >= 2 && i <= 32;
        }
        if (!is_alphanumeric_byte(character) && character != '+' && character != '-' && character != '.') {
            return false;
        }
    }
    return false;
}

bool is_email(str body) {
    Option<int> at_sign = body.index_of("@");
    match (at_sign) {
        case None: {
            return false;
        }
        case Some(int at_index): {
            if (at_index == 0 || at_index + 1 >= body.size()) {
                return false;
            }
            for (int i in 0 .. at_index) {
                int character = body.byte_at(i);
                if (!is_alphanumeric_byte(character) && MAIL_LOCAL.index_of(str.from_chars([character])).is_none()) {
                    return false;
                }
            }
            return has_valid_labels(body.substr(at_index + 1, body.size()));
        }
    }
}

const str MAIL_LOCAL = ".!#$%&'*+/=?^_`{|}~-";

bool has_valid_labels(str host) {
    for (str label in host.split(".")) {
        int length = label.size();
        if (length == 0 || length > 63) {
            return false;
        }
        if (!is_alphanumeric_byte(label.byte_at(0)) || !is_alphanumeric_byte(label.byte_at(length - 1))) {
            return false;
        }
        int index = 1;
        while (index < length - 1) {
            int character = label.byte_at(index);
            if (!is_alphanumeric_byte(character) && character != '-') {
                return false;
            }
            index = index + 1;
        }
    }
    return host.size() > 0;
}

// --- links and images --------------------------------------------------------

// What a `(dest "title")` clause came to.
type Target {
    bool is_valid;
    str href;
    str title;
    int after;
}

int link(List<Node> nodes, str source, List<int> shuts, Map<str, MD_doc.Reference> references, int start, int from, int depth) {
    int bang = 0;
    if (source.byte_at(start) == '!') {
        bang = 1;
    }
    // A link may not hold another link, so inside one a `[` is literal. An
    // image may, because its content becomes plain text either way.
    if (bang == 0 && depth > 0) {
        return start;
    }
    int open = start + bang;
    if (open >= shuts.size()) {
        return start;
    }
    int shut = shuts[open];
    if (shut < 0) {
        return start;
    }
    // An inline destination is tried first and wins; only when `](` does not
    // begin a valid one does the bracket get a chance as a reference.
    Target clause = Target(false, "", "", start);
    if (shut + 1 < source.size() && source.byte_at(shut + 1) == '(') {
        clause = target(source, shut + 2);
    }
    if (!clause.is_valid) {
        clause = reference_target(source, shuts, references, open, shut);
    }
    if (!clause.is_valid) {
        return start;
    }
    flush(nodes, source, from, start);
    nodes.push(html_node(link_html(bang, source.substr(open + 1, shut), clause, references, depth)));
    return clause.after;
}

// The `<a>` or `<img>` for one link whose text is `inner` and whose
// destination and title are in `clause`.
str link_html(int bang, str inner, Target clause, Map<str, MD_doc.Reference> references, int depth) {
    List<str> out = [];
    if (bang == 1) {
        out.push("<img src=\"");
        out.push(escape_href(clause.href));
        out.push("\" alt=\"");
        out.push(plain(inner, references));
        out.push("\"");
        if (clause.title.size() > 0) {
            out.push(" title=\"");
            out.push(html.escape(clause.title));
            out.push("\"");
        }
        out.push(" />");
    } else {
        out.push("<a href=\"");
        out.push(escape_href(clause.href));
        out.push("\"");
        if (clause.title.size() > 0) {
            out.push(" title=\"");
            out.push(html.escape(clause.title));
            out.push("\"");
        }
        out.push(">");
        out.push(render_at(inner, references, depth + 1));
        out.push("</a>");
    }
    return out.join("");
}

// --- reference links ---------------------------------------------------------

/// The longest label CommonMark allows, in characters between the brackets.
/// A `\x` escape counts once, as the reference implementation counts it; here
/// the unit is a byte, so a label of two-byte letters is cut at 500 of them.
const int LABEL_LIMIT = 1000;

/// The offset just past the `]` of the link label that starts at `start`
/// (which must hold a `[`), or -1 if what is there is not a label: an
/// unescaped bracket inside, no closing `]`, or more than `LABEL_LIMIT`
/// characters.
pub int label_end(str source, int start) {
    int length = source.size();
    if (start >= length || source.byte_at(start) != '[') {
        return -1;
    }
    int index = start + 1;
    int count = 0;
    while (index < length) {
        int character = source.byte_at(index);
        if (character == ']') {
            return index + 1;
        }
        if (character == '[') {
            return -1;
        }
        if (character == '\\') {
            if (index + 1 >= length) {
                return -1;
            }
            index = index + 2;
        } else {
            index = index + 1;
        }
        count = count + 1;
        if (count > LABEL_LIMIT) {
            return -1;
        }
    }
    return -1;
}

/// `label`, the text between a label's brackets, as the key it matches by:
/// trimmed, every run of white space one space, and case folded (so `ẞ`
/// and `SS` agree). "" is a label that is nothing but space, which no
/// definition may have.
pub str normalize_label(str label) {
    return unicode.fold(text.split_whitespace(label).join(" "));
}

// The reference a bracket pair `source[open..shut]` stands for, as a `Target`,
// or an invalid one. Three shapes, by what follows the `]`:
//
//   [text][label]   the label in the second brackets
//   [text][]        the text is the label
//   [label]         likewise, when no label follows
//
// A second pair of brackets that is a label but names nothing is not a
// fallback to the shortcut form: `[foo][bar]` with only `foo` defined is
// literal. The first pair doubles as the label only if it holds no brackets
// of its own.
Target reference_target(str source, List<int> shuts, Map<str, MD_doc.Reference> references, int open, int shut) {
    Target none = Target(false, "", "", open);
    if (references.size() == 0) {
        return none;
    }
    int after = shut + 1;
    int label_stop = -1;
    if (after < source.size() && source.byte_at(after) == '[') {
        label_stop = label_end(source, after);
    }
    str key = "";
    int stop = after;
    if (label_stop > after + 2) {
        key = normalize_label(source.substr(after + 1, label_stop - 1));
        stop = label_stop;
    } else {
        // Too long to be a label, or holding a bracket: not one. The scan is
        // bounded by the length test first, so it costs one label's worth at
        // most.
        if (shut - open > LABEL_LIMIT + 1) {
            return none;
        }
        for (int index in open + 1 .. shut) {
            if (shuts[index] >= 0) {
                return none;
            }
        }
        key = normalize_label(source.substr(open + 1, shut));
        if (label_stop == after + 2) {
            stop = label_stop;
        }
    }
    if (key.size() == 0) {
        return none;
    }
    match (references.get(key)) {
        case Some(MD_doc.Reference found): {
            return Target(true, found.href, found.title, stop);
        }
        case None: {
            return none;
        }
    }
}

int skip_code(str source, int start) {
    int length = source.size();
    int run_end = start;
    while (run_end < length && source.byte_at(run_end) == '`') {
        run_end = run_end + 1;
    }
    int want = run_end - start;
    int cursor = run_end;
    while (cursor < length) {
        if (source.byte_at(cursor) == '`') {
            int close_end = cursor;
            while (close_end < length && source.byte_at(close_end) == '`') {
                close_end = close_end + 1;
            }
            if (close_end - cursor == want) {
                return close_end;
            }
            cursor = close_end;
        } else {
            cursor = cursor + 1;
        }
    }
    return run_end;
}

// `(dest)`, `(dest "title")`, `()` -- `start` is just past the `(`.
Target target(str source, int start) {
    int length = source.size();
    int cursor = skip_whitespace(source, start);
    str href = "";
    if (cursor < length && source.byte_at(cursor) == '<') {
        int stop = cursor + 1;
        while (stop < length && source.byte_at(stop) != '>' && source.byte_at(stop) != '\n') {
            if (source.byte_at(stop) == '\\') {
                stop = stop + 1;
            }
            stop = stop + 1;
        }
        if (stop >= length || source.byte_at(stop) != '>') {
            return Target(false, "", "", start);
        }
        href = unescape(source.substr(cursor + 1, stop));
        cursor = stop + 1;
    } else {
        int stop = cursor;
        int depth = 0;
        while (stop < length) {
            int character = source.byte_at(stop);
            if (character == '\\' && stop + 1 < length) {
                stop = stop + 2;
                continue;
            }
            if (is_space_byte(character)) {
                break;
            }
            if (character == '(') {
                depth = depth + 1;
            } else if (character == ')') {
                if (depth == 0) {
                    break;
                }
                depth = depth - 1;
            }
            stop = stop + 1;
        }
        href = unescape(source.substr(cursor, stop));
        cursor = stop;
    }
    int probe = skip_whitespace(source, cursor);
    str title = "";
    if (probe > cursor || probe < length && source.byte_at(probe) == ')') {
        if (probe < length && (source.byte_at(probe) == '"' || source.byte_at(probe) == '\'' || source.byte_at(probe) == '(')) {
            int shut = 34;
            if (source.byte_at(probe) == '\'') {
                shut = 39;
            }
            if (source.byte_at(probe) == '(') {
                shut = 41;
            }
            int stop = probe + 1;
            while (stop < length && source.byte_at(stop) != shut) {
                if (source.byte_at(stop) == '\\') {
                    stop = stop + 1;
                }
                stop = stop + 1;
            }
            if (stop >= length) {
                return Target(false, "", "", start);
            }
            title = unescape(source.substr(probe + 1, stop));
            probe = skip_whitespace(source, stop + 1);
        }
    }
    if (probe >= length || source.byte_at(probe) != ')') {
        return Target(false, "", "", start);
    }
    return Target(true, href, title, probe + 1);
}

int skip_whitespace(str source, int start) {
    int length = source.size();
    int index = start;
    while (index < length && is_space_byte(source.byte_at(index))) {
        index = index + 1;
    }
    return index;
}

/// Backslash escapes resolved, for text that is about to become an attribute
/// rather than inline content.
pub str unescape(str source) {
    if (source.index_of("\\").is_none()) {
        return source;
    }
    List<str> out = [];
    int length = source.size();
    int index = 0;
    int from = 0;
    while (index < length) {
        if (source.byte_at(index) == '\\' && index + 1 < length && is_punctuation_byte(source.byte_at(index + 1))) {
            out.push(source.substr(from, index));
            index = index + 1;
            from = index;
        }
        index = index + 1;
    }
    out.push(source.substr(from, length));
    return out.join("");
}

str strip_tags(str source) {
    if (source.index_of("<").is_none()) {
        return source;
    }
    List<str> out = [];
    int length = source.size();
    int index = 0;
    int from = 0;
    while (index < length) {
        if (source.byte_at(index) == '<') {
            out.push(source.substr(from, index));
            while (index < length && source.byte_at(index) != '>') {
                index = index + 1;
            }
            if (index < length) {
                index = index + 1;
            }
            from = index;
        } else {
            index = index + 1;
        }
    }
    out.push(source.substr(from, length));
    return out.join("");
}

// --- emphasis ----------------------------------------------------------------

// CommonMark's "process emphasis", and it is reproduced here down to the
// parts that look like accidents, because they decide real documents:
//
//   * closers are walked left to right; for each, openers are walked
//     backwards to the `bottom` for that character;
//   * `bottom` is raised when a closer finds nothing -- but ONLY if the last
//     candidate it looked at was not refused by the rule of three, because a
//     `**` that fails to match an earlier `*` may still become an opener;
//   * `is_odd_match` therefore leaks out of the search loop carrying the LAST
//     candidate's verdict, which is what makes `_c` on the line above change
//     whether `**a*b**` is strong. That is not a typo here; it is what the
//     reference implementation does, and matching it is the point.
//
// A matched pair spends two delimiters if both runs have two, otherwise one,
// and everything still on the stack between the pair comes off it.
void emphasis(List<Node> nodes) {
    List<int> delimiters = [];
    for (int i in 0 .. nodes.size()) {
        if (nodes[i].is_delimiter) {
            delimiters.push(i);
        }
    }
    // One bottom per delimiter character: -1 is the bottom of the stack.
    int bottom_star = -1;
    int bottom_score = -1;
    int closer_slot = 0;
    while (closer_slot < delimiters.size()) {
        Node closing_node = nodes[delimiters[closer_slot]];
        if (closing_node.is_dead || !closing_node.can_close) {
            closer_slot = closer_slot + 1;
            continue;
        }
        int bottom = bottom_star;
        if (closing_node.character == 95) {
            bottom = bottom_score;
        }
        int previous = alive_before(nodes, delimiters, closer_slot);
        int opener_slot = closer_slot - 1;
        int found = -1;
        bool is_odd_match = false;
        while (opener_slot >= 0 && found < 0) {
            Node opening_node = nodes[delimiters[opener_slot]];
            if (opening_node.is_dead) {
                opener_slot = opener_slot - 1;
                continue;
            }
            if (delimiters[opener_slot] == bottom) {
                opener_slot = -1;
                continue;
            }
            is_odd_match = (closing_node.can_open || opening_node.can_close) && closing_node.original % 3 != 0 && (opening_node.original + closing_node.original) % 3 == 0;
            if (opening_node.character == closing_node.character && opening_node.can_open && !is_odd_match) {
                found = opener_slot;
            } else {
                opener_slot = opener_slot - 1;
            }
        }
        if (found < 0) {
            closer_slot = closer_slot + 1;
            if (!is_odd_match) {
                if (closing_node.character == 95) {
                    bottom_score = previous;
                } else {
                    bottom_star = previous;
                }
                if (!closing_node.can_open) {
                    closing_node.is_dead = true;
                }
            }
            continue;
        }
        Node opening_node = nodes[delimiters[found]];
        int use = 1;
        if (closing_node.count >= 2 && opening_node.count >= 2) {
            use = 2;
        }
        opening_node.count = opening_node.count - use;
        closing_node.count = closing_node.count - use;
        if (use == 2) {
            opening_node.open_tags = "<strong>" + opening_node.open_tags;
            closing_node.close_tags = closing_node.close_tags + "</strong>";
        } else {
            opening_node.open_tags = "<em>" + opening_node.open_tags;
            closing_node.close_tags = closing_node.close_tags + "</em>";
        }
        for (int slot in found + 1 .. closer_slot) {
            nodes[delimiters[slot]].is_dead = true;
        }
        if (opening_node.count == 0) {
            opening_node.is_dead = true;
        }
        if (closing_node.count == 0) {
            closing_node.is_dead = true;
            closer_slot = closer_slot + 1;
        }
    }
}

// The node index of the nearest delimiter still on the stack before `closer_slot`, or
// -1 for the bottom of it.
int alive_before(List<Node> nodes, List<int> delimiters, int closer_slot) {
    int opener_slot = closer_slot - 1;
    while (opener_slot >= 0) {
        if (!nodes[delimiters[opener_slot]].is_dead) {
            return delimiters[opener_slot];
        }
        opener_slot = opener_slot - 1;
    }
    return -1;
}

str emit(List<Node> nodes) {
    List<str> out = [];
    for (Node node in nodes) {
        if (node.is_delimiter) {
            out.push(node.close_tags);
            if (node.count > 0) {
                out.push(mark_of(node.character).repeat(node.count));
            }
            out.push(node.open_tags);
        } else {
            out.push(node.out);
        }
    }
    return out.join("");
}
